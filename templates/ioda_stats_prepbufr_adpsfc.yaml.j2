datasets:
  - name: ObsMonitor
    type: IodaStats
    filenames_template:
      template: {{ runtime_dir }}/prepbufr_adpsfc_%Y%m%d%H_output_atmos.nc
      start: "{{ start_time | to_isotime }}"
      end: "{{ end_time | to_isotime }}"
      interval_hours: {{ interval_hours }}
    groups:
    - name: byDomains/ombg/stationPressure
      variables:
      - mean
      - count
      - RMS
    - name: byDomains/oman/stationPressure
      variables:
      - mean
      - count
      - RMS
    - name: griddedBins/ombg/stationPressure
      variables:
      - mean
      - count
      - RMS
    variables:
     - validTime

graphics:

  plotting_backend: Emcpy
  figure_list:

  # Ioda Stats Time Series

  # Mean Departures
  - figure:
      layout: [1,1]
      title: '{{ ob_type }} stationPressure Global Time Series - Mean'
      output name: {{ runtime_dir }}/plots/{{ variable }}/stationPressure/{{ variable }}_mean_stationPressure_global_time_series_{{ start_time | to_YMDH }}_{{ end_time | to_YMDH }}.png
    plots:
      - add_xlabel: 'Datetime'
        add_ylabel: 'Departure'
        add_grid:
        add_legend:
          loc: 'upper left'
        layers:
        - type: LinePlot
          drop_nan: false
          x:
            variable: ObsMonitor::MetaData::validTime
          y:
            variable: ObsMonitor::byDomains_ombg_stationPressure::mean
            slices: '[:,-1]'
          markersize: 5
          color: 'blue'
          label: 'O-F'
        - type: LinePlot
          drop_nan: false
          x:
            variable: ObsMonitor::MetaData::validTime
          y:
            variable: ObsMonitor::byDomains_oman_stationPressure::mean
            slices: '[:,-1]'
          markersize: 5
          color: 'red'
          label: 'O-A'